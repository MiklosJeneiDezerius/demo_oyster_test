/// Daily core account spend snapshots with 30-day rolling totals; all ledger rows included.
table g_fct_periodic_spend_snapshot
	lineageTag: 0cff53d2-37cb-4958-bc31-837b830cbf73

	/// 30-day spend at the last snapshot date in the current filter context; never sums overlapping daily windows.
	measure 'Total Spend' =
			VAR _snapshotDate = CALCULATE(MAX('g_fct_periodic_spend_snapshot'[SnapshotDate]), REMOVEFILTERS('g_fct_periodic_spend_snapshot'[CalculatedSpendingTier]))
			RETURN CALCULATE(SUM('g_fct_periodic_spend_snapshot'[Rolling30DaySpend]), 'g_fct_periodic_spend_snapshot'[SnapshotDate] = _snapshotDate)
		formatString: #,##0.00
		lineageTag: dad47475-2998-487c-a27d-36f816de7791

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Distinct accounts at the last snapshot date in the current filter context.
	measure 'Total Accounts' =
			VAR _snapshotDate = CALCULATE(MAX('g_fct_periodic_spend_snapshot'[SnapshotDate]), REMOVEFILTERS('g_fct_periodic_spend_snapshot'[CalculatedSpendingTier]))
			RETURN CALCULATE(DISTINCTCOUNT('g_fct_periodic_spend_snapshot'[AccountID]), 'g_fct_periodic_spend_snapshot'[SnapshotDate] = _snapshotDate)
		formatString: #,##0
		lineageTag: a9b66d99-9dce-4728-bc23-9b3326980e63

		changedProperty = Name

	/// Accounts with at least 5000 spend in the latest 30-day snapshot.
	measure 'Platinum Accounts' = COALESCE(CALCULATE([Total Accounts], KEEPFILTERS('g_fct_periodic_spend_snapshot'[CalculatedSpendingTier] = "Platinum")), 0)
		formatString: #,##0
		lineageTag: ea9c93bc-7b7a-4db9-be8c-74965bb5acd9

	/// Accounts with 2000 to less than 5000 spend in the latest 30-day snapshot.
	measure 'Gold Accounts' = COALESCE(CALCULATE([Total Accounts], KEEPFILTERS('g_fct_periodic_spend_snapshot'[CalculatedSpendingTier] = "Gold")), 0)
		formatString: #,##0
		lineageTag: 4b0dd1c2-acbe-4144-90be-81fd93f2015d

	measure 'Total No. of Cards' =
			COALESCE (
				DISTINCTCOUNTNOBLANK ( 'g_fct_periodic_spend_snapshot'[CardSK] ),
				0
			)
		formatString: 0
		lineageTag: bf2fce6e-d850-45a4-bd8a-056f22010f55

		changedProperty = Name

	measure 'Upgrade Candidate Cards' =
			CALCULATE (
				[Total No. of Cards],
				KEEPFILTERS ( 'g_fct_periodic_spend_snapshot'[IsUpgradeCandidate] = 1 )
			)
		formatString: 0
		lineageTag: 1effcd3f-9ba9-48e1-abd8-86cacdd55a2b

		changedProperty = Name

	measure 'Downgrade Candidate Cards' =
			CALCULATE (
				[Total No. of Cards],
				KEEPFILTERS ( 'g_fct_periodic_spend_snapshot'[IsLowSpendPremiumAnomaly] = 1 )
			)
		formatString: 0
		lineageTag: ff1f27c3-3ad8-4550-8ef3-058b48e80aa0

		changedProperty = Name

	measure 'Misaligned Cards' =
			CALCULATE (
				[Total No. of Cards],
				KEEPFILTERS ( 'g_fct_periodic_spend_snapshot'[AlignmentStatus] = "Misaligned" )
			)
		formatString: 0
		lineageTag: a9c3570b-91a0-4e6e-81b0-48115b1131cb

		changedProperty = Name

	measure 'Aligned Cards' =
			CALCULATE (
				[Total No. of Cards],
				KEEPFILTERS ( 'g_fct_periodic_spend_snapshot'[AlignmentStatus] = "Aligned" )
			)
		formatString: 0
		lineageTag: 2bc9f0aa-182b-4bad-91ac-e094436f0cae

		changedProperty = Name

	measure 'Tier Mismatch Rate' =
			DIVIDE ( [Misaligned Cards], [Total No. of Cards], 0 )
		lineageTag: 04e6108a-e922-460e-9122-dcde6884c441

		changedProperty = Name

	column SpendSnapshotSK
		dataType: string
		isHidden
		sourceProviderType: varchar(64)
