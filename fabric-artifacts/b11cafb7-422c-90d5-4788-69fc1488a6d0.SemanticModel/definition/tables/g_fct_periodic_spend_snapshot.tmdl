table g_fct_periodic_spend_snapshot
	lineageTag: 7eca8dea-1257-4149-9330-a11501275bc7
	sourceLineageTag: [oystr_gold].[g_fct_periodic_spend_snapshot]

	measure 'Total No. of Cards' =
			
			COALESCE (
			    DISTINCTCOUNTNOBLANK (
			        'g_fct_periodic_spend_snapshot'[s_dim_card_sk]
			    ),
			    0
			)
		formatString: 0
		lineageTag: 85578c83-8f89-44ec-b347-911c1ef9806c

		changedProperty = Name

	measure 'Upgrade Candidate Cards' =
			
			CALCULATE (
			    [Total No. of Cards],
			    KEEPFILTERS (
			        'g_fct_periodic_spend_snapshot'[is_upgrade_candidate_flag] = 1
			    )
			)
		formatString: 0
		lineageTag: 071e7394-ac9d-4eee-be18-5b5dc161c6b7

		changedProperty = Name

	measure 'Downgrade Candidate Cards' =
			
			CALCULATE (
			    [Total No. of Cards],
			    KEEPFILTERS (
			        'g_fct_periodic_spend_snapshot'[is_low_spend_premium_anomaly_flag] = 1
			    )
			)
		formatString: 0
		lineageTag: feb72e30-3dc4-4342-bde9-47d579a0c7a8

		changedProperty = Name

	measure 'Misaligned Cards' =
			
			CALCULATE (
			    [Total No. of Cards],
			    KEEPFILTERS (
			        'g_fct_periodic_spend_snapshot'[alignment_status_cd] = "Misaligned"
			    )
			)
		formatString: 0
		lineageTag: 0fd4a540-c693-41bf-9198-8bfc897f50c7

		changedProperty = Name

	measure 'Aligned Cards' =
			
			CALCULATE (
			    [Total No. of Cards],
			    KEEPFILTERS (
			        'g_fct_periodic_spend_snapshot'[alignment_status_cd] = "Aligned"
			    )
			)
		formatString: 0
		lineageTag: c1d134b6-bef5-446a-97e8-cd9032e27ddd

		changedProperty = Name

	measure 'Tier Mismatch Rate' =
			
			DIVIDE ( [Misaligned Cards], [Total No. of Cards], 0 )
		lineageTag: c153450f-b8bb-46af-a08e-3f7ae3a8cdd1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

