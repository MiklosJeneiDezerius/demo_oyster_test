table g_fct_periodic_spend_snapshot
	lineageTag: 0cff53d2-37cb-4958-bc31-837b830cbf73
	sourceLineageTag: [oystr_gold].[g_fct_periodic_spend_snapshot]

	measure 'Total Spend' = SUM(g_fct_periodic_spend_snapshot[Rolling30DaySpend])
		lineageTag: dad47475-2998-487c-a27d-36f816de7791

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Cardholders' = DISTINCTCOUNT(g_fct_periodic_spend_snapshot[AccountID])
		formatString: 0
		lineageTag: a9b66d99-9dce-4728-bc23-9b3326980e63

		changedProperty = Name

	measure 'Misaligned Cardholders' = ```
			
			COALESCE(
			    CALCULATE(
			        [Total Cardholders], 
			        g_fct_periodic_spend_snapshot[AlignmentStatusFlag] = "Misaligned"
			    ), 
			    0
			)
			```
		formatString: 0
		lineageTag: e9e50199-2f52-4e89-9687-397544bb5f02

		changedProperty = Name

	measure 'Tier Mismatch Rate' = DIVIDE([Misaligned Cardholders], [Total Cardholders], 0)
		lineageTag: 3290eae6-2087-476e-b01f-01599016d83f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Upgrade Candidates' = COALESCE(CALCULATE([Total Cardholders], g_fct_periodic_spend_snapshot[IsUpgradeCandidate] = 1),0)
		formatString: 0
		lineageTag: f5550820-8e45-455a-84f0-89fc2a87a067

		changedProperty = Name

	measure 'Aligned Cardholders' = ```
			
			COALESCE(
			    CALCULATE(
			        [Total Cardholders], 
			        g_fct_periodic_spend_snapshot[AlignmentStatusFlag] = "Aligned"
			    ), 
			    0
			)
			```
		formatString: 0
		lineageTag: aeb5d2e5-d887-40b9-bddd-f3dea89d3e2e

		changedProperty = Name

